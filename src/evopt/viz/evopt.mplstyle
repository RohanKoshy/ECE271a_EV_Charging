figure.facecolor: white
figure.dpi: 110
savefig.dpi: 200
savefig.bbox: tight
font.size: 10
axes.titlesize: 11
axes.titleweight: bold
axes.titlelocation: left
axes.labelsize: 10
axes.labelcolor: 52514a
axes.edgecolor: c3c2b7
axes.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.axisbelow: True
grid.color: e8e6dc
grid.linewidth: 0.6
xtick.color: 52514a
ytick.color: 52514a
xtick.major.size: 0
ytick.major.size: 0
lines.linewidth: 2
legend.frameon: False
